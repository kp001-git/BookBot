# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Comma-separated list of Telegram user IDs with administrative privileges
ADMIN_IDS=123456789,987654321

# Storage channel where books/audiobooks are posted or forwarded (e.g., -1001234567890)
STORAGE_CHANNEL_ID=-1001234567890

# Optional: Updates channel where new indexed releases are broadcasted
UPDATES_CHANNEL_ID=-1001987654321

# Database Persistence Configuration
# Mode A (Recommended for Render/Cloud): Managed PostgreSQL (Supabase / Neon / Render Postgres)
# DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/neondb
DATABASE_URL=

# Mode B: Fallback SQLite (Local file with automated 6-hour Telegram cloud backup)
DB_PATH=data/library.db

# Optional Bot Username override (without @). If omitted, the bot fetches it automatically at startup.
BOT_USERNAME=AudioSoulBot

# Optional: Telegram API credentials for running historical backfill script (utils/backfill.py)
# Obtain these from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
